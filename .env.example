# GameCrate.lk - Environment Configuration Template
# Copy this template or set system environment variables in GlassFish / OS

# JavaMail SMTP Configuration (Google App Password)
APP_EMAIL=support@gamecrate.lk
APP_PASSWORD=your_google_app_password_here

# PayHere Payment Gateway Sandbox / Live Credentials
PAYHERE_MERCHANT_ID=1226818
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret_here
PAYHERE_NOTIFY_URL=http://localhost:8080/GameCrate/VerifyPayments

# Database Credentials (configured in src/java/hibernate.cfg.xml)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=game_crate_db
DB_USER=root
DB_PASSWORD=
